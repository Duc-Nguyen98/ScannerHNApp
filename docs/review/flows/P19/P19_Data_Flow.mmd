  P19_data_s3["<b>P19.S03</b><br/>Review từ lines hiện hành"]:::panel
  P19_data_req["Request Post cố định danh<br/>Case + Document + Session + Version"]:::guard
  P19_data_adapter["Post / Check adapter mô phỏng"]:::action
  P19_data_unknown["UNKNOWN giữ nguyên request<br/>Không tạo lệnh Post thứ hai"]:::guard
  P19_data_receipt[("Receipt POSTED đã xác minh<br/>Case ID · Receipt ID · Request ID")]:::store
