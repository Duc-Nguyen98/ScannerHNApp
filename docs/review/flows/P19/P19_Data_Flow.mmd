  P19_data_catalog[("Danh mục mã đơn / BOX<br/>SKU · Tồn khả dụng đã xác minh")]:::store
  P19_data_s2["<b>P19.S02</b><br/>Quantity tạm trong sheet<br/>Hủy không thêm dòng"]:::panel
  P19_data_validate["Kiểm mã + số lượng + tồn<br/>Case/quyền/kho vẫn hợp lệ"]:::guard
