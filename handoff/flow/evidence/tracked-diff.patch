+async function loadMoreHistory(node, state, button, readPage = readHistoryFixturePage) {
+  if (
+    state.loading || !state.hasMore ||
+    !["history", "history-error", "closed"].includes(state.scene)
+  ) return;
+
+  const request = { state };
+  historyRequests.set(node, request);
+  state.loading = true;
+  const hadFocus = document.activeElement === button;
+  button.disabled = true;
+  button.textContent = "Đang tải thêm…";
+  node.querySelector(".history-block").setAttribute("aria-busy", "true");
+
+  const isCurrent = () =>
+    historyRequests.get(node) === request &&
+    sceneStates.get(node) === state && node.isConnected;
+  const finish = (failed) => {
+    const top = node.querySelector(".body").scrollTop;
+    const restoreFocus = hadFocus &&
+      (document.activeElement === button || document.activeElement === document.body);
+    historyRequests.delete(node);
+    state.loading = false;
+    state.historyError = failed;
+    go(node, state.scene === "closed" ? "closed" : failed ? "history-error" : "history");
+    node.querySelector(".body").scrollTop = top;
+    if (restoreFocus) {
+      const target = node.querySelector('[data-action="load-more"]') ||
+        node.querySelector(".end-list");
+      if (target) {
+        if (target.classList.contains("end-list")) target.tabIndex = -1;
+        target.focus({ preventScroll: true });
+      }
+    }
+  };
+
+  try {
+    const page = await readPage();
+    if (!isCurrent()) return;
+    // Validate the complete fixture page before changing the visible list.
+    if (!Array.isArray(page) || !page.every(isHistoryFixtureDocument)) {
+      throw new TypeError("Invalid design history fixture page");
+    }
+    const merged = new Map(state.historyDocs.map((doc) => [doc.id, doc]));
+    for (const doc of page) merged.set(doc.id, structuredClone(doc));
+    state.historyDocs = [...merged.values()];
+    state.hasMore = false; // This design fixture contains the final page only.
+    finish(false);
+  } catch {
+    if (isCurrent()) finish(true);
+  } finally {
+    if (historyRequests.get(node) === request) {
+      historyRequests.delete(node);
+      state.loading = false;
+    }
+  }
