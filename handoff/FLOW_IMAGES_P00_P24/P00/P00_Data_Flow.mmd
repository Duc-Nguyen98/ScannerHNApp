  P00_data_router["AppShell / Router<br/>Chỉ truyền ID và ngữ cảnh"]:::action
  P00_data_owners[("Owner theo nghiệp vụ<br/>P04/P05: record · P19: Post<br/>P09: hồ sơ · P07: mapping")]:::store
  P00_data_request["Yêu cầu cố định danh<br/>Request ID · Document/Case ID<br/>Scan session · Version"]:::guard
  P00_data_adapter["Adapter hiện có<br/>Dữ liệu mô phỏng trong trang"]:::action
  P00_data_unknown["UNKNOWN<br/>Giữ request, khóa gửi lại"]:::guard
  P00_data_check["Đọc / Đối chiếu đúng yêu cầu"]:::action
  P00_data_receipt[("Kết quả đã xác minh<br/>Không suy thành công từ timeout")]:::store
  P00_data_projection["Nguồn dùng chung / Phép chiếu<br/>Không tạo lại record theo nhãn PN"]:::action
