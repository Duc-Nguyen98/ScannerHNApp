flowchart TB
  P21_data_owner[("Owner P19 hiện có<br/>Document ID · Case ID · Session<br/>Version · Lines · Request/receipt")]:::store
  P21_data_s1["<b>P21.S01</b><br/>Danh sách pending từ live owner<br/>Không dựng lại từ số phiếu"]:::panel
  P21_data_read["Nguồn checkpoint đọc theo ID<br/>Cùng scope và generation"]:::action
  P21_data_compare["So document/session/version<br/>Recorded lines / UNKNOWN status"]:::guard
  P21_data_s2["<b>P21.S02</b><br/>Checkpoint khớp<br/>Mở lại chính owner P19"]:::panel
  P21_data_s3["<b>P21.S03</b><br/>Conflict / Chưa xác minh<br/>Read-only, không sửa bằng dữ liệu đoán"]:::panel
  P21_data_s4["<b>P21.S04</b><br/>Request UNKNOWN được giữ nguyên"]:::panel
  P21_data_status["Đọc trạng thái request<br/>Case đóng vẫn được check yêu cầu cũ"]:::action
  P21_data_receipt[("Receipt POSTED có nguồn<br/>Case + Document + Request khớp")]:::store
  P21_data_notpost["Xác nhận chưa Post<br/>Đọc lại checkpoint, không auto-Post"]:::action
  P21_data_history["P20 dùng đúng receipt<br/>Caller/scroll/focus cùng case"]:::action
  P21_data_stale["Response cũ / Mất phiên / Đổi owner<br/>Không cập nhật vào phiếu khác"]:::blocked
  P21_data_owner --> P21_data_s1
  P21_data_s1 --> P21_data_read
  P21_data_owner --> P21_data_compare
  P21_data_read --> P21_data_compare
  P21_data_compare -->|"Khớp"| P21_data_s2
  P21_data_compare -->|"Lệch / Không rõ"| P21_data_s3
  P21_data_compare -->|"Post UNKNOWN"| P21_data_s4
  P21_data_s2 -->|"Resume cùng đối tượng"| P21_data_owner
  P21_data_s4 --> P21_data_status
  P21_data_status -->|"Đã Post xác minh"| P21_data_receipt
  P21_data_receipt --> P21_data_history
  P21_data_status -->|"Chưa Post xác minh"| P21_data_notpost
  P21_data_notpost --> P21_data_read
  P21_data_read -->|"Scope/generation đổi"| P21_data_stale
