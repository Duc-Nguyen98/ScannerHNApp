flowchart TB
  P15_data_error["Lỗi từ owner / Adapter / Session<br/>Không lấy thông báo text làm kết quả ghi"]:::action
  P15_data_ctx[("Ngữ cảnh màn gọi<br/>Route · Action · Request ID<br/>Document ID · Scope · Focus/scroll")]:::store
  P15_data_classify["classifySystemError<br/>Intent: đọc / ghi / đối chiếu"]:::guard
  P15_data_s1["<b>P15.S01</b><br/>Network state + callback retry hợp lệ"]:::panel
  P15_data_s2["<b>P15.S02</b><br/>Session expiry<br/>Vô hiệu callback và DOM cũ"]:::panel
  P15_data_s3["<b>P15.S03</b><br/>Permission denial<br/>Guard tại handler và route"]:::panel
  P15_data_s4["<b>P15.S04</b><br/>Trạng thái khả năng/quyền thiết bị"]:::panel
  P15_data_owner["Owner vẫn sở hữu yêu cầu<br/>P15 không tạo request nghiệp vụ mới"]:::action
  P15_data_unknown["UNKNOWN giữ nguyên request<br/>Chỉ gọi read/check được cho phép"]:::guard
  P15_data_back["Khôi phục context khi được phép<br/>Không phục hồi phiên đã bị thu hồi"]:::action
