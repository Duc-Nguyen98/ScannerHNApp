  "rules": [
    {
      "id": "RBAC-001",
      "title": "Deny by default",
      "condition": "permission không có grant hoặc scope không khớp",
      "expected": "deny",
      "status": "proposed-test"
    },
    {
      "id": "RBAC-002",
      "title": "Session owner",
      "condition": "actorId/authSessionId/warehouseId đổi giữa request và response",
      "expected": "deny mutation; ignore late response",
      "status": "implemented-fixture"
    },
    {
      "id": "RBAC-004",
      "title": "Unknown is not success",
      "condition": "unknown/timeout/status-unavailable",
      "expected": "keep request; check same request before retry",
      "status": "implemented-fixture"
    },
    {
      "id": "RBAC-011",
      "title": "Tenant isolation",
      "condition": "tenantId/organizationId mismatch",
      "expected": "deny read and mutation",
      "status": "proposed-test"
    },
    {
      "id": "RBAC-013",
      "title": "Least privilege",
      "condition": "viewer/auditor invokes create/update/post",
      "expected": "deny without mutation",
      "status": "proposed-test"
    },
    {
      "id": "RBAC-015",
      "title": "No sensitive leakage",
      "condition": "export/log/reader payload",
      "expected": "exclude password/token; keep business IDs",
      "status": "implemented-fixture"
    }
